{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "背单词",
  "version": "1.0.0",
  "identifier": "io.github.xeycmd.word",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5178/word/",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "高中必背 3600 词",
        "width": 1100,
        "height": 800,
        "minWidth": 360,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.ico"],
    "shortDescription": "高中必背 3600 词",
    "longDescription": "高中英语必背 3855 词背诵工具：卡片、选择题、拼写、间隔复习、错词本、打卡统计。"
  }
}
